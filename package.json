{
  "name": "saas-pos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS POS backend foundation for retail, restaurant, and hybrid businesses.",
  "license": "UNLICENSED",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
