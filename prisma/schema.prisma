generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPPORT_ADMIN
  SUPER_ADMIN
}

enum BusinessType {
  RETAIL
  RESTAURANT
  HYBRID
}

enum BusinessRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  CHEF
  KITCHEN_MANAGER
  STOCK_MANAGER
  ACCOUNTANT
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTAGE
  TRANSFER_IN
  TRANSFER_OUT
}

enum OrderStatus {
  DRAFT
  OPEN
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum KotStatus {
  OPEN
  IN_PROGRESS
  READY
  SERVED
  CANCELLED
}

enum ServiceFeeType {
  FIXED
  PERCENTAGE
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  fullName        String           @map("full_name")
  email           String           @unique
  phone           String?
  passwordHash    String           @map("password_hash")
  platformRole    PlatformRole     @default(USER) @map("platform_role")
  emailVerifiedAt DateTime?        @map("email_verified_at")
  phoneVerifiedAt DateTime?        @map("phone_verified_at")
  isActive        Boolean          @default(true) @map("is_active")
  lastLoginAt     DateTime?        @map("last_login_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  memberships     BusinessMember[]
  refreshTokens   RefreshToken[]
  invitations     UserInvitation[] @relation("InvitationCreator")
  auditLogs       AuditLog[]

  @@map("users")
}

model Business {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String
  legalName          String?                @map("legal_name")
  registrationNumber String?                @map("registration_number")
  businessType       BusinessType           @map("business_type")
  countryCode        String                 @map("country_code") @db.VarChar(2)
  currencyCode       String                 @map("currency_code") @db.VarChar(3)
  timezone           String
  taxProfileId       String?                @map("tax_profile_id") @db.Uuid
  subscriptionPlanId String?                @map("subscription_plan_id") @db.Uuid
  isActive           Boolean                @default(true) @map("is_active")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  members            BusinessMember[]
  branches           Branch[]
  invitations        UserInvitation[]
  subscriptions      BusinessSubscription[]
  auditLogs          AuditLog[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  suppliers          Supplier[]
  stockMovements     StockMovement[]
  orders             Order[]
  payments           Payment[]
  restaurantTables   RestaurantTable[]
  kitchenTickets     KitchenOrderTicket[]
  orderServices      OrderService[]
  kitchenStations    KitchenStation[]

  @@index([countryCode])
  @@map("businesses")
}

model BusinessMember {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  businessId    String         @map("business_id") @db.Uuid
  role          BusinessRole
  status        MemberStatus   @default(ACTIVE)
  joinedAt      DateTime       @default(now()) @map("joined_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branchMembers BranchMember[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_members")
}

model Branch {
  id               String               @id @default(uuid()) @db.Uuid
  businessId       String               @map("business_id") @db.Uuid
  name             String
  code             String
  addressLine1     String?              @map("address_line_1")
  addressLine2     String?              @map("address_line_2")
  city             String?
  state            String?
  postalCode       String?              @map("postal_code")
  countryCode      String?              @map("country_code") @db.VarChar(2)
  phone            String?
  email            String?
  timezone         String?
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branchMembers    BranchMember[]
  auditLogs        AuditLog[]
  stockMovements   StockMovement[]
  orders           Order[]
  payments         Payment[]
  restaurantTables RestaurantTable[]
  kitchenTickets   KitchenOrderTicket[]
  orderServices    OrderService[]
  kitchenStations  KitchenStation[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("branches")
}

model BranchMember {
  id               String         @id @default(uuid()) @db.Uuid
  businessMemberId String         @map("business_member_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  businessMember   BusinessMember @relation(fields: [businessMemberId], references: [id], onDelete: Restrict)
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([businessMemberId, branchId])
  @@index([branchId])
  @@map("branch_members")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  createdByIp       String?   @map("created_by_ip")
  revokedByIp       String?   @map("revoked_by_ip")
  userAgent         String?   @map("user_agent")
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model UserInvitation {
  id              String             @id @default(uuid()) @db.Uuid
  businessId      String             @map("business_id") @db.Uuid
  email           String
  fullName        String?            @map("full_name")
  role            BusinessRole
  tokenHash       String             @map("token_hash")
  expiresAt       DateTime           @map("expires_at")
  acceptedAt      DateTime?          @map("accepted_at")
  revokedAt       DateTime?          @map("revoked_at")
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy       User               @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  branches        InvitationBranch[]

  @@index([businessId])
  @@index([email])
  @@map("user_invitations")
}

model InvitationBranch {
  id           String         @id @default(uuid()) @db.Uuid
  invitationId String         @map("invitation_id") @db.Uuid
  branchId     String         @map("branch_id") @db.Uuid
  invitation   UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@unique([invitationId, branchId])
  @@map("invitation_branches")
}

model SubscriptionPlan {
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String
  code                   String                 @unique
  monthlyPrice           Decimal                @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice            Decimal                @map("yearly_price") @db.Decimal(12, 2)
  currencyCode           String                 @map("currency_code") @db.VarChar(3)
  maximumBranches        Int                    @map("maximum_branches")
  maximumUsers           Int                    @map("maximum_users")
  maximumRegisters       Int                    @map("maximum_registers")
  retailEnabled          Boolean                @default(true) @map("retail_enabled")
  restaurantEnabled      Boolean                @default(false) @map("restaurant_enabled")
  kotEnabled             Boolean                @default(false) @map("kot_enabled")
  kitchenDisplayEnabled  Boolean                @default(false) @map("kitchen_display_enabled")
  advancedReportsEnabled Boolean                @default(false) @map("advanced_reports_enabled")
  multiBranchEnabled     Boolean                @default(false) @map("multi_branch_enabled")
  isActive               Boolean                @default(true) @map("is_active")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  subscriptions          BusinessSubscription[]

  @@map("subscription_plans")
}

model BusinessSubscription {
  id                    String             @id @default(uuid()) @db.Uuid
  businessId            String             @map("business_id") @db.Uuid
  subscriptionPlanId    String             @map("subscription_plan_id") @db.Uuid
  status                SubscriptionStatus @default(TRIALING)
  startsAt              DateTime           @map("starts_at")
  trialEndsAt           DateTime?          @map("trial_ends_at")
  currentPeriodStartsAt DateTime           @map("current_period_starts_at")
  currentPeriodEndsAt   DateTime           @map("current_period_ends_at")
  cancelledAt           DateTime?          @map("cancelled_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  business              Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscriptionPlan      SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("business_subscriptions")
}

model CountryConfig {
  id                         String  @id @default(uuid()) @db.Uuid
  countryCode                String  @unique @map("country_code") @db.VarChar(2)
  countryName                String  @map("country_name")
  currencyCode               String  @map("currency_code") @db.VarChar(3)
  currencySymbol             String  @map("currency_symbol")
  timezone                   String
  dateFormat                 String  @map("date_format")
  numberFormat               String  @map("number_format")
  taxInclusivePricingDefault Boolean @default(false) @map("tax_inclusive_pricing_default")
  isActive                   Boolean @default(true) @map("is_active")

  @@map("country_configs")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roleLinks   RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id             String       @id @default(uuid()) @db.Uuid
  role           BusinessRole
  permissionCode String       @map("permission_code")
  permission     Permission   @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@unique([role, permissionCode])
  @@map("role_permissions")
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String?   @map("business_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  action         String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id")
  previousValues Json?     @map("previous_values")
  newValues      Json?     @map("new_values")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")
  business       Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([branchId])
  @@index([userId])
  @@map("audit_logs")
}

model Category {
  id               String          @id @default(uuid()) @db.Uuid
  businessId       String          @map("business_id") @db.Uuid
  name             String
  description      String?
  kitchenStationId String?         @map("kitchen_station_id") @db.Uuid
  kitchenStation   KitchenStation? @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  kotPrinterIp     String?         @map("kot_printer_ip")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products         Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([kitchenStationId])
  @@map("categories")
}

model Product {
  id           String          @id @default(uuid()) @db.Uuid
  businessId   String          @map("business_id") @db.Uuid
  categoryId   String?         @map("category_id") @db.Uuid
  name         String
  sku          String
  barcode      String?
  description  String?
  currencyCode String          @map("currency_code") @db.VarChar(3)
  sellingPrice Decimal         @map("selling_price") @db.Decimal(12, 2)
  costPrice    Decimal?        @map("cost_price") @db.Decimal(12, 2)
  taxRate      Decimal?        @map("tax_rate") @db.Decimal(5, 2)
  status       ProductStatus   @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements    StockMovement[]
  orderItems   OrderItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@map("products")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  fullName   String   @map("full_name")
  email      String?
  phone      String?
  taxNumber  String?  @map("tax_number")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orders     Order[]

  @@index([businessId])
  @@index([businessId, phone])
  @@map("customers")
}

model Supplier {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  address    String?
  taxNumber  String?  @map("tax_number")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, name])
  @@index([businessId])
  @@map("suppliers")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @map("business_id") @db.Uuid
  branchId    String            @map("branch_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  type        StockMovementType
  quantity    Decimal           @db.Decimal(14, 3)
  reason      String?
  reference   String?
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([branchId])
  @@index([productId])
  @@map("stock_movements")
}

model Order {
  id             String               @id @default(uuid()) @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  branchId       String               @map("branch_id") @db.Uuid
  customerId     String?              @map("customer_id") @db.Uuid
  orderNumber    String               @map("order_number")
  notes          String?
  tableName      String?              @map("table_name")
  serviceName    String?              @map("service_name")
  serviceFee     Decimal              @default(0) @map("service_fee") @db.Decimal(12, 2)
  status         OrderStatus          @default(OPEN)
  currencyCode   String               @map("currency_code") @db.VarChar(3)
  subtotal       Decimal              @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal              @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal  Decimal              @default(0) @map("discount_total") @db.Decimal(12, 2)
  grandTotal     Decimal              @default(0) @map("grand_total") @db.Decimal(12, 2)
  createdById    String?              @map("created_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch         Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  kitchenTickets KitchenOrderTicket[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([branchId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  name        String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  businessId        String        @map("business_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(COMPLETED)
  currencyCode      String        @map("currency_code") @db.VarChar(3)
  amount            Decimal       @db.Decimal(12, 2)
  providerReference String?       @map("provider_reference")
  receivedById      String?       @map("received_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([branchId])
  @@index([orderId])
  @@map("payments")
}

model RestaurantTable {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  name       String
  code       String
  seats      Int      @default(2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([businessId, branchId, code])
  @@index([businessId])
  @@index([branchId])
  @@map("restaurant_tables")
}

enum KotItemChangeType {
  NEW
  MODIFIED
  CANCELLED
  UNCHANGED
}

model KitchenOrderTicket {
  id           String                   @id @default(uuid()) @db.Uuid
  businessId   String                   @map("business_id") @db.Uuid
  branchId     String                   @map("branch_id") @db.Uuid
  orderId      String                   @map("order_id") @db.Uuid
  ticketNumber String                   @map("ticket_number")
  version      Int                      @default(1)
  isUpdate     Boolean                  @default(false) @map("is_update")
  status       KotStatus                @default(OPEN)
  notes        String?
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  business     Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch       Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order        Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items        KitchenOrderTicketItem[]

  @@unique([businessId, ticketNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([orderId])
  @@map("kitchen_order_tickets")
}

model KitchenOrderTicketItem {
  id               String             @id @default(uuid()) @db.Uuid
  kotId            String             @map("kot_id") @db.Uuid
  productId        String             @map("product_id") @db.Uuid
  name             String
  quantity         Decimal            @db.Decimal(14, 3)
  previousQuantity Decimal?           @map("previous_quantity") @db.Decimal(14, 3)
  changeType       KotItemChangeType  @default(NEW) @map("change_type")
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  kot              KitchenOrderTicket @relation(fields: [kotId], references: [id], onDelete: Cascade)

  @@index([kotId])
  @@index([productId])
  @@map("kitchen_order_ticket_items")
}


model OrderService {
  id          String         @id @default(uuid()) @db.Uuid
  businessId  String         @map("business_id") @db.Uuid
  branchId    String         @map("branch_id") @db.Uuid
  name        String
  code        String
  feeType     ServiceFeeType @default(FIXED) @map("fee_type")
  feeValue    Decimal        @default(0.00) @map("fee_value") @db.Decimal(12, 2)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([businessId, branchId, code])
  @@index([businessId])
  @@index([branchId])
  @@map("order_services")
}

model KitchenStation {
  id          String     @id @default(uuid()) @db.Uuid
  businessId  String     @map("business_id") @db.Uuid
  branchId    String?    @map("branch_id") @db.Uuid
  name        String
  code        String
  printerIp   String?    @map("printer_ip")
  printerPort Int        @default(9100) @map("printer_port")
  description String?
  isDefault   Boolean    @default(false) @map("is_default")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  categories  Category[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([branchId])
  @@map("kitchen_stations")
}
